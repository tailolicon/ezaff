# ezaff owner-link Worker (FR-10 / plan §4)
# Secrets: set via `wrangler secret put` or `.dev.vars` locally — never commit.
# Required for Shopee Open API provider (disabled without both):
#   SHOPEE_APP_ID
#   SHOPEE_SECRET

name = "ezaff-owner-link"
main = "src/index.ts"
compatibility_date = "2024-09-23"

# KV: mapping table + response cache + rate-limit counters
[[kv_namespaces]]
binding = "OWNER_KV"
# Replace with real IDs after `wrangler kv namespace create ezaff-owner`
id = "00000000000000000000000000000000"
preview_id = "00000000000000000000000000000000"

[vars]
# Public non-secret flags only. Credentials stay in secrets / .dev.vars.
ENVIRONMENT = "development"
